# Preserve existing SUFFIX if set
PRESERVED_SUFFIX="${SUFFIX:-}"

# Load standard environment variables from .env if it exists
if [ -f .env ]; then
  # We source it so that bash-style exports and variables (like FOLDER_ID, etc.) are evaluated
  source .env
fi

# Restore preserved SUFFIX if it was set
if [ -n "$PRESERVED_SUFFIX" ] && [ "$PRESERVED_SUFFIX" != "\$RANDOM" ]; then
  export SUFFIX="$PRESERVED_SUFFIX"
fi

# Ensure SUFFIX is set. If .env has export SUFFIX=$RANDOM, it evaluates dynamically.
# We ensure we have a stable SUFFIX for the current shell session.
if [ -z "$SUFFIX" ] || [ "$SUFFIX" = "\$RANDOM" ]; then
  export SUFFIX=$RANDOM
fi

# Define project name variables based on the stable SUFFIX
export PROJ_A="vpcsc-data-proj-$SUFFIX"
export PROJ_B="vpcsc-view-proj-$SUFFIX"
export SA_NAME="test-viewer-sa"
export SA_EMAIL="$SA_NAME@$PROJ_B.iam.gserviceaccount.com"

# Map environment variables to Terraform inputs
export TF_VAR_org_id="$ORG_ID"
export TF_VAR_billing_id="$BILLING_ID"

export TF_VAR_suffix="$SUFFIX"
export TF_VAR_proj_a="$PROJ_A"
export TF_VAR_proj_b="$PROJ_B"
export TF_VAR_sa_name="$SA_NAME"
export TF_VAR_sa_email="$SA_EMAIL"

# Retrieve active gcloud identity to use as runner account in IAM policies
export CURRENT_USER=$(gcloud config get-value account 2>/dev/null)
export TF_VAR_current_user="$CURRENT_USER"
export TF_VAR_policy_id="$POLICY_ID"

# Get active gcloud project to use as billing override project for ACM
export ACTIVE_PROJECT=$(gcloud config get-value project 2>/dev/null || echo "")
export TF_VAR_billing_project="$ACTIVE_PROJECT"

